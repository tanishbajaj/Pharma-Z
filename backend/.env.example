# === Application ===
APP_NAME=Pharma-Z
APP_VERSION=1.0.0
DEBUG=true

# === Database ===
DATABASE_URL=sqlite:///./pharma_z.db

# === Blockchain (Ganache) ===
BLOCKCHAIN_PROVIDER_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=

# === Privacy ===
DP_NOISE_MULTIPLIER=1.0
DP_MAX_GRAD_NORM=1.0

# === ML Training ===
DEFAULT_BATCH_SIZE=64
DEFAULT_EPOCHS=50
DEFAULT_LEARNING_RATE=0.001
DEFAULT_LATENT_DIM=128

# === Paths ===
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
SAVED_MODELS_DIR=data/saved_models
LOGS_DIR=logs
